# ============================================
# AI Microservice Environment Configuration
# ============================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Security
AI_SERVICE_API_KEY=your-ai-service-secret-key

# Logging
LOG_LEVEL=info

# Model Configuration
MODEL_PATH=./models
ENABLE_MODEL_RETRAINING=true

# External API Configuration (for fetching event data)
MAIN_API_URL=http://localhost:5000
MAIN_API_KEY=your-main-api-key