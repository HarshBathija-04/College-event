# Quad AI service - copy to .env for local development
ENVIRONMENT=development
PORT=5117
LOG_LEVEL=INFO

# Shared secret; must match AI_SERVICE_API_KEY on the backend
AI_SERVICE_API_KEY=change-me-shared-secret

# Groq LLM (assistant + description writer). Get a key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key
# GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Optional: comma-separated browser origins (the service is normally called only by the backend)
# CORS_ORIGINS=
