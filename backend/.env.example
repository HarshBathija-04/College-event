# Quad backend - copy to .env for local development
NODE_ENV=development
PORT=5116

# Postgres connection. All portfolio apps share one database; tables live in DB_SCHEMA.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/portfolio
DB_SCHEMA=college_event

# JWT signing secret (required in production). JWT_REFRESH_SECRET is optional.
JWT_SECRET=change-me-to-a-long-random-string
# JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:5208

# Python AI service and the shared key used between the two services
AI_SERVICE_URL=http://localhost:5117
AI_SERVICE_API_KEY=change-me-shared-secret

# Set to false to disable scheduled notification jobs
ENABLE_CRON=true
