{
  "name": "quad-backend",
  "version": "2.0.0",
  "private": true,
  "description": "REST API for Quad, the college event aggregator",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:prod": "npm run db:deploy && npm run db:seed:prod && node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db.js migrate dev",
    "db:deploy": "node scripts/db.js migrate deploy",
    "db:seed": "tsx src/utils/seed.ts",
    "db:seed:prod": "node dist/utils/seed.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "express-validator": "7.2.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "node-cron": "3.0.3",
    "prisma": "5.22.0",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.8",
    "@types/morgan": "1.9.9",
    "@types/node": "22.13.1",
    "@types/node-cron": "3.0.11",
    "@types/supertest": "6.0.2",
    "eslint": "9.19.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.23.0",
    "vitest": "3.0.5"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.23.1": true,
    "esbuild@0.25.12": true,
    "prisma@5.22.0": true
  }
}
